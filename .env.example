# The Glances servers to watch: comma-separated name=url pairs. Required.
# Each must run Glances 4 in web server mode (`glances -w`, port 61208 by default).
# The name is yours to choose (letters, digits, ".", "-", "_"); it is shown in the app and used in its URLs.
# For a password-protected server put the credentials in the URL: http://glances:password@nas:61208
GLANCES_HOSTS=local=http://localhost:61208

# Port the server listens on in production (`npm start`, Docker). Default 3000.
# `npm run dev` ignores it: the web app is on 3000 and the API on 8787.
# PORT=3000

# How often every host is sampled, in seconds: a number from 1 to 300. Default 3.
# It is also the fastest "Update every" choice on the app's Settings page, and the history charts
# cover 200 samples, so 3 keeps ten minutes and 30 keeps a hundred.
# SAMPLE_INTERVAL_SECONDS=3

# Proxies in front of this server that may set X-Forwarded-For. Default false (none).
# "1" for one reverse proxy; never "true" when the port is reachable from the internet.
# TRUST_PROXY=1
